 "insulin": {
  "byType": {
   "meal": "Do not take short-acting or meal-time insulin while you are fasting - you only take this insulin with food. Keep taking your background (long-acting) insulin as advised on its own card - add it to this list to see its instruction.",
   "premix": "If you take an evening dose: take 80% of your usual dose the evening before surgery. On the morning of surgery: if your surgery is in the morning, do not take your morning premixed insulin while fasting - check your blood glucose and bring your insulin and monitor to hospital. If your surgery is in the afternoon (after 1 pm), have the early light breakfast the hospital allows and take half (50%) of your usual morning dose with it. Do not take any dose you would not normally take.",
   "pump": "Do not stop or suspend your insulin pump. Continue your usual basal rate, and contact the rooms before surgery so the hospital can plan your pump and check your blood glucose."
  },
  "basalOrIntermediateByTiming": {
   "am": "Take half (50%) of your usual morning dose on the morning of surgery, at your usual time. Do not take any other insulin dose you would not normally take. Check your blood glucose.",
   "pm": "Take half (50%) of your usual evening dose the evening before surgery. You do not normally take a morning dose, so take no insulin on the morning of surgery. Check your blood glucose.",
   "bd": "Take half (50%) of your usual evening dose the evening before surgery, and half (50%) of your usual morning dose on the morning of surgery. Check your blood glucose."
  },
  "type1Note": "Because you have type 1 diabetes, never stop your background (long-acting) insulin completely - the hospital will watch your blood glucose closely on the day, and may use an insulin drip for bigger operations. Please contact the rooms to confirm your plan."
 },
