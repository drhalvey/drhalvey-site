 "rules": {
  "CONTINUE": {
   "kind": "continue",
   "text": "Continue as normal, including on the morning of surgery (with a small sip of water).",
   "html": "Continue as normal, including on the morning of surgery (with a small sip of water).",
   "lastDoseDaysBefore": null,
   "dateLabel": null
  },
  "ASPIRIN": {
   "kind": "continue",
   "text": "Low-dose aspirin is usually continued. Keep taking it unless Dr Halvey or your surgeon has told you to stop.",
   "html": "Low-dose aspirin is usually continued. Keep taking it unless Dr Halvey or your surgeon has told you to stop.",
   "lastDoseDaysBefore": null,
   "dateLabel": null
  },
  "BRING": {
   "kind": "continue",
   "text": "Continue as normal and bring it to hospital with you.",
   "html": "Continue as normal and bring it to hospital with you.",
   "lastDoseDaysBefore": null,
   "dateLabel": null
  },
  "SKIP_DAY": {
   "kind": "stop",
   "text": "Take as usual until the day before surgery. Do not take it on the morning of surgery.",
   "html": "Take as usual until the day before surgery. Do not take it on the morning of surgery.",
   "lastDoseDaysBefore": 1,
   "dateLabel": "Last dose"
  },
  "DIAB_TABLET": {
   "kind": "stop",
   "text": "Take as usual until the night before surgery. Do not take it on the day of surgery. Restart when you are eating and drinking normally.",
   "html": "Take as usual until the night before surgery. Do not take it on the day of surgery. Restart when you are eating and drinking normally.",
   "lastDoseDaysBefore": 1,
   "dateLabel": "Last dose"
  },
  "COX2": {
   "kind": "continue",
   "text": "This anti-inflammatory (a coxib) is usually fine to continue, as it has little effect on bleeding. Your anaesthetist may pause it if your kidneys are a concern.",
   "html": "This anti-inflammatory (a coxib) is usually fine to continue, as it has little effect on bleeding. Your anaesthetist may pause it if your kidneys are a concern.",
   "lastDoseDaysBefore": null,
   "dateLabel": null
  },
  "NSAID": {
   "kind": "stop",
   "text": "Stop this anti-inflammatory 2 to 3 days before surgery, because it can increase bleeding.",
   "html": "Stop this anti-inflammatory 2 to 3 days before surgery, because it can increase bleeding.",
   "lastDoseDaysBefore": 3,
   "dateLabel": "Last dose"
  },
  "STEROID": {
   "kind": "continue",
   "text": "Do not stop suddenly. Continue, and tell your anaesthetist - you may need extra 'stress' doses around surgery.",
   "html": "Do not stop suddenly. Continue, and tell your anaesthetist - you may need extra 'stress' doses around surgery.",
   "lastDoseDaysBefore": null,
   "dateLabel": null
  },
  "CLONIDINE": {
   "kind": "continue",
   "text": "Continue as normal, including on the morning of surgery. Do not stop this suddenly - stopping can cause rebound high blood pressure.",
   "html": "Continue as normal, including on the morning of surgery. Do not stop this suddenly - stopping can cause rebound high blood pressure.",
   "lastDoseDaysBefore": null,
   "dateLabel": null
  },
  "STOP7": {
   "kind": "stop",
   "text": "Stop at least 7 days before surgery.",
   "html": "Stop at least 7 days before surgery.",
   "lastDoseDaysBefore": 7,
   "dateLabel": "Last dose"
  },
  "GLP1": {
   "kind": "glp",
   "text": "Keep taking this as normal. On the day, follow the special fasting rules for these medicines: clear fluids only from 24 hours before, water only from 6 hours before (max 200 ml/hour), and nothing from 2 hours before. See the medicines page.",
   "html": "Keep taking this as normal. On the day, follow the special fasting rules for these medicines: clear fluids only from 24 hours before, water only from 6 hours before (max 200 ml/hour), and nothing from 2 hours before. See the <a href='medicines-before-surgery.html'>medicines page</a>.",
   "lastDoseDaysBefore": null,
   "dateLabel": null
  },
  "GLP1_ORAL": {
   "kind": "glp",
   "text": "Do not take your tablet on the morning of surgery - it is taken on an empty stomach with water and food afterwards, so it is skipped while fasting. Otherwise keep taking it as normal. On the day, follow the special fasting rules for these medicines: clear fluids only from 24 hours before, water only from 6 hours before (max 200 ml/hour), and nothing from 2 hours before. See the medicines page.",
   "html": "Do not take your tablet on the morning of surgery - it is taken on an empty stomach with water and food afterwards, so it is skipped while fasting. Otherwise keep taking it as normal. On the day, follow the special fasting rules for these medicines: clear fluids only from 24 hours before, water only from 6 hours before (max 200 ml/hour), and nothing from 2 hours before. See the <a href='medicines-before-surgery.html'>medicines page</a>.",
   "lastDoseDaysBefore": null,
   "dateLabel": null
  },
  "SGLT2": {
   "kind": "stop",
   "text": "Stop this medicine 3 days before surgery (none on the two days before, or the day of surgery) because of a risk of ketoacidosis. If you are having a day procedure with no bowel preparation, such as a gastroscopy on its own, you only need to skip it on the day of the procedure. If you are not sure which applies to you, use the 3-day date. Restart only when you are eating, drinking and well.",
   "html": "Stop this medicine 3 days before surgery (none on the two days before, or the day of surgery) because of a risk of ketoacidosis. If you are having a day procedure with no bowel preparation, such as a gastroscopy on its own, you only need to skip it on the day of the procedure. If you are not sure which applies to you, use the 3-day date. Restart only when you are eating, drinking and well.",
   "lastDoseDaysBefore": 3,
   "dateLabel": "Last dose"
  },
  "WARFARIN": {
   "kind": "stop",
   "text": "Stop warfarin 5 days before surgery. You will usually need an INR blood test, and some people need 'bridging' injections - the rooms or your warfarin clinic will arrange this.",
   "html": "Stop warfarin 5 days before surgery. You will usually need an INR blood test, and some people need 'bridging' injections - the rooms or your warfarin clinic will arrange this.",
   "lastDoseDaysBefore": 5,
   "dateLabel": "Last dose"
  },
  "CLOPIDOGREL": {
   "kind": "stop",
   "text": "Stop 7 days before surgery. If you have a heart stent, do not stop without checking with the rooms first - it may need to continue.",
   "html": "Stop 7 days before surgery. <b>If you have a heart stent, do not stop without checking with the rooms first</b> - it may need to continue.",
   "lastDoseDaysBefore": 7,
   "dateLabel": "Last dose"
  },
  "TICAGRELOR": {
   "kind": "stop",
   "text": "Stop 5 days before surgery. If you have a heart stent, do not stop without checking with the rooms first.",
   "html": "Stop 5 days before surgery. <b>If you have a heart stent, do not stop without checking with the rooms first.</b>",
   "lastDoseDaysBefore": 5,
   "dateLabel": "Last dose"
  },
  "PRASUGREL": {
   "kind": "stop",
   "text": "Stop 7 days before surgery. If you have a heart stent, do not stop without checking with the rooms first.",
   "html": "Stop 7 days before surgery. <b>If you have a heart stent, do not stop without checking with the rooms first.</b>",
   "lastDoseDaysBefore": 7,
   "dateLabel": "Last dose"
  },
  "DIPYRIDAMOLE": {
   "kind": "stop",
   "text": "Stop 2 days before surgery. If it is combined with aspirin (Asasantin), the aspirin part is usually continued - check with the rooms.",
   "html": "Stop 2 days before surgery. If it is combined with aspirin (Asasantin), the aspirin part is usually continued - check with the rooms.",
   "lastDoseDaysBefore": 2,
   "dateLabel": "Last dose"
  },
  "LMWH": {
   "kind": "stop",
   "text": "If you take a low (preventive) dose: last dose at least 12 hours before surgery. If you take a high (treatment) dose: last dose at least 24 hours before. The rooms will confirm which applies to you.",
   "html": "If you take a low (preventive) dose: last dose at least 12 hours before surgery. If you take a high (treatment) dose: last dose at least 24 hours before. The rooms will confirm which applies to you.",
   "lastDoseDaysBefore": null,
   "dateLabel": null
  },
  "LITHIUM": {
   "kind": "stop",
   "text": "Continue for minor surgery. For major surgery, take your last dose the day before (stop about 24 hours before). The rooms will confirm, and you may need a blood test.",
   "html": "Continue for minor surgery. For major surgery, take your last dose the day before (stop about 24 hours before). The rooms will confirm, and you may need a blood test.",
   "lastDoseDaysBefore": 1,
   "dateLabel": "Last dose (major surgery)"
  },
  "HRT": {
   "kind": "continue",
   "text": "Usually continued, with measures to prevent blood clots. If you are at higher risk of clots, it may be stopped 4 to 6 weeks before surgery - the rooms will advise based on your operation and your risk.",
   "html": "Usually continued, with measures to prevent blood clots. If you are at higher risk of clots, it may be stopped 4 to 6 weeks before surgery - the rooms will advise based on your operation and your risk.",
   "lastDoseDaysBefore": null,
   "dateLabel": null
  },
  "BIOLOGIC": {
